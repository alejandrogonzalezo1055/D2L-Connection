# Copiar a common/.env y reemplazar los valores de ejemplo.
# common/.env NO se versiona. Los valores de este archivo son falsos.

# Host del mock de Brightspace (solo IP o nombre, sin http:// ni puerto).
# El puerto 8800 va fijo en el código. Requiere Tailscale.
MOCK_API_BASE_URL=192.0.2.10
MOCK_AUTH_BASE_URL=192.0.2.10

# Credenciales de la aplicación registrada en el mock
APP_ID=00000000-0000-0000-0000-000000000000
APP_SECRET=cambia-por-el-secreto-real

# Scopes separados por espacios
APP_SCOPE="users:own_profile:read enrollment:own_enrollment:read enrollment:orgunit:read dropbox:folders:read,write grades:gradeobjects:read grades:gradevalues:read grades:own_grades:read"
